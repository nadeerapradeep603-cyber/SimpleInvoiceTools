---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [{ label: 'Contact Us' }];
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || 'https://formspree.io/f/support@simpleinvoicetools.com';
---

<BaseLayout
  title="Contact Us — SimpleInvoiceTools"
  description="Get in touch with the SimpleInvoiceTools team for feedback, bug reports, feature suggestions, or general inquiries."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-16">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="my-8 text-center max-w-2xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-3">
        Get in Touch
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Have a question, feedback, or a tool request? Drop us a message below or email us directly.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start my-8">
      
      <!-- Contact Info Sidebar (4 Cols) -->
      <div class="md:col-span-4 space-y-6 glass-card p-6 rounded-2xl">
        <h2 class="text-lg font-extrabold text-white pb-3 border-b border-slate-800">
          Direct Contact
        </h2>
        
        <div class="space-y-4 text-xs sm:text-sm">
          <div>
            <span class="text-slate-400 block text-xs mb-1 font-semibold">Email Us Directly</span>
            <a href="mailto:support@simpleinvoicetools.com" class="text-indigo-400 font-mono hover:underline font-bold text-sm">
              support@simpleinvoicetools.com
            </a>
          </div>

          <div>
            <span class="text-slate-400 block text-xs mb-1 font-semibold">Response Time</span>
            <p class="text-slate-300">We typically reply within 24 to 48 business hours.</p>
          </div>

          <div class="pt-4 border-t border-slate-800 text-xs text-slate-400 space-y-2">
            <p class="font-semibold text-slate-300">🔒 Privacy Promise</p>
            <p>Your email address and message details will only be used to respond to your inquiry. We never share or sell contact information.</p>
          </div>
        </div>
      </div>

      <!-- Client-Side Formspree/Mailto Contact Form (8 Cols) -->
      <div class="md:col-span-8 glass-card p-6 sm:p-8 rounded-2xl space-y-6">
        <h2 class="text-xl font-extrabold text-white flex items-center justify-between border-b border-slate-800 pb-3">
          <span>Send a Message</span>
          <span class="text-xs text-slate-400 font-normal">Client-Side Direct Form</span>
        </h2>

        <form
          action={formspreeEndpoint}
          method="POST"
          class="space-y-4"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-slate-300 mb-1">
                Your Name
              </label>
              <input
                id="contact-name"
                type="text"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full px-3 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-semibold text-slate-300 mb-1">
                Email Address
              </label>
              <input
                id="contact-email"
                type="email"
                name="email"
                required
                placeholder="jane@example.com"
                class="w-full px-3 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-slate-300 mb-1">
              Subject Category
            </label>
            <select
              id="contact-subject"
              name="subject"
              class="w-full px-3 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="General Feedback">General Feedback</option>
              <option value="Bug Report">Bug Report</option>
              <option value="New Tool Suggestion">New Tool Suggestion</option>
              <option value="Business Inquiry">Business / Ad Inquiry</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-semibold text-slate-300 mb-1">
              Message
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Tell us how we can help..."
              class="w-full px-3 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 shadow-lg shadow-indigo-500/25 transition-all cursor-pointer focus:ring-2 focus:ring-indigo-400"
          >
            Send Message
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>
      </div>

    </div>
  </div>
</BaseLayout>
