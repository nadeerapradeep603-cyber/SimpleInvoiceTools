---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tools, categories } from '../../data/tools';

const breadcrumbItems = [{ label: 'Tools Hub' }];
---

<BaseLayout
  title="All Free Business Tools & Invoicing Calculators — SimpleInvoiceTools"
  description="Filter and search our complete collection of free browser-based business tools, PDF invoice generators, VAT calculators, and hourly rate tools."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-16">
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Header Section -->
    <div class="my-8 text-center max-w-3xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-3">
        Business <span class="gradient-text">Tools Hub</span>
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Browse our full directory of client-side business utilities. Select any category filter below to filter tools instantly.
      </p>
    </div>

    <!-- Client-Side Category Filter Bar -->
    <div class="my-8 space-y-4">
      <div class="flex flex-wrap items-center justify-center gap-2 max-w-4xl mx-auto" role="group" aria-label="Tool Category Filters">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class={`cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold border transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 ${
                idx === 0
                  ? 'active-cat bg-indigo-600 text-white border-indigo-500 shadow-md shadow-indigo-600/25'
                  : 'bg-slate-900 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white'
              }`}
              aria-pressed={idx === 0 ? 'true' : 'false'}
            >
              {cat}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Ad Slot Placeholder -->
    <AdSlot slotId="tools-hub-banner" format="horizontal" label="ADVERTISEMENT" />

    <!-- Filterable Tools Grid -->
    <div id="tools-hub-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {
        tools.map((tool) => (
          <div
            class="tool-card-item"
            data-group={tool.group}
            data-category={tool.category}
          >
            <ToolCard
              title={tool.title}
              description={tool.description}
              href={`/tools/${tool.slug}`}
              category={tool.category}
              icon={tool.icon}
              badge={tool.popular ? 'Popular' : undefined}
              estimatedTime={tool.estimatedTime}
              tags={tool.tags}
            />
          </div>
        ))
      }
    </div>

    <!-- Empty Filter Fallback -->
    <div id="empty-filter-state" class="hidden text-center py-16 glass-card rounded-2xl my-8">
      <div class="w-12 h-12 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center mx-auto mb-3">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 9.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h2 class="text-lg font-bold text-white mb-1">No Tools Found</h2>
      <p class="text-xs text-slate-400">No tools match the selected filter category.</p>
    </div>

  </div>

  <!-- Pure Client-Side Filtering Script -->
  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn');
    const toolItems = document.querySelectorAll<HTMLElement>('.tool-card-item');
    const emptyState = document.getElementById('empty-filter-state');

    function filterTools(selectedCategory: string) {
      let matchCount = 0;

      toolItems.forEach((item) => {
        const itemCategory = item.dataset.category || '';
        const itemGroup = item.dataset.group || '';

        const matches =
          selectedCategory === 'All' ||
          selectedCategory === itemCategory ||
          selectedCategory === itemGroup;

        if (matches) {
          item.classList.remove('hidden');
          matchCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (emptyState) {
        if (matchCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.category || 'All';

        // Update button styles and aria attributes
        filterButtons.forEach((b) => {
          b.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold border transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 bg-slate-900 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white';
          b.setAttribute('aria-pressed', 'false');
        });

        btn.className = 'cat-filter-btn active-cat px-4 py-2 rounded-xl text-xs font-bold border transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 bg-indigo-600 text-white border-indigo-500 shadow-md shadow-indigo-600/25';
        btn.setAttribute('aria-pressed', 'true');

        filterTools(category);
      });
    });
  </script>
</BaseLayout>
