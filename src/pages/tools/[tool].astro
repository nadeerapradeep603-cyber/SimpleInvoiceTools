---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import Card from '../../components/Card.astro';
import { tools, tools as allTools, type Tool } from '../../data/tools';
import { DocumentGeneratorIsland } from '../../components/DocumentGeneratorIsland';
import { TaxCalculatorIsland } from '../../components/TaxCalculatorIsland';
import { ProfitMarginCalculatorIsland } from '../../components/ProfitMarginCalculatorIsland';
import ProfitMarginContent from '../../components/ProfitMarginContent.astro';
import {
  INVOICE_CONFIG,
  QUOTE_CONFIG,
  RECEIPT_CONFIG,
  PO_CONFIG,
  PROFORMA_CONFIG,
  DELIVERY_NOTE_CONFIG,
} from '../../utils/documentConfigs';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { tool: tool.slug },
    props: { toolData: tool },
  }));
}

interface Props {
  toolData: Tool;
}

const { toolData } = Astro.props;

if (!toolData) {
  return Astro.redirect('/tools');
}

const breadcrumbItems = [
  { label: 'Tools Hub', href: '/tools' },
  { label: toolData.title },
];

const relatedTools = allTools
  .filter((t) => t.slug !== toolData.slug && t.category === toolData.category)
  .slice(0, 3);

// Map tool slug to modular document configuration
const getDocConfig = (slug: string) => {
  switch (slug) {
    case 'quote-generator':
      return QUOTE_CONFIG;
    case 'receipt-generator':
      return RECEIPT_CONFIG;
    case 'po-generator':
      return PO_CONFIG;
    case 'proforma-generator':
      return PROFORMA_CONFIG;
    case 'delivery-note-generator':
      return DELIVERY_NOTE_CONFIG;
    case 'invoice-generator':
    default:
      return INVOICE_CONFIG;
  }
};

const docConfig = getDocConfig(toolData.slug);
const isDocumentGenerator = toolData.group === 'Document Generators';
const isProfitMarginTool = toolData.slug === 'profit-margin-calculator';

// 1. SoftwareApplication Schema.org JSON-LD
const schemaSoftwareApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: toolData.title,
  description: toolData.description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any (Web-based)',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

// 2. FAQPage Schema.org JSON-LD (Generated from page FAQs)
const profitMarginFaqs = [
  {
    q: 'What is a healthy profit margin for freelancers and solo business owners?',
    a: 'Service-based freelancers typically aim for a 50% to 80% gross profit margin, because service businesses have lower physical inventory costs. Product-based businesses or agencies with high payroll costs usually operate around 15% to 35% net profit margins.',
  },
  {
    q: 'What is the difference between Profit Margin and Markup?',
    a: 'Profit Margin measures profit as a percentage of total revenue, whereas Markup measures profit as a percentage of cost. For example, if an item costs $50 and sells for $100, the profit is $50. The profit margin is 50% ($50 / $100), but the markup is 100% ($50 / $50).',
  },
  {
    q: 'Why does my profit margin drop when I hire subcontractors?',
    a: 'Subcontractor fees are direct cost items (COGS). If you pay a developer $1,000 on a $2,000 client project without increasing your overall fee, your profit drops to $1,000 and your margin shrinks from 100% to 50%. Always mark up contractor costs when building client estimates.',
  },
  {
    q: 'Should I include my own hourly wages in the project cost?',
    a: 'In solo freelancing, your labor is part of your net profit draw. However, if you run a formal agency or plan to delegate tasks, you should factor labor wages into project costs so your business margin accurately reflects company profitability beyond owner pay.',
  },
  {
    q: 'Can profit margin ever exceed 100%?',
    a: 'No. Because profit margin is calculated as a fraction of total revenue (Profit / Revenue), profit margin can never exceed 100%. Markup, on the other hand, can easily exceed 100% or 200% if your selling price is more than double your cost.',
  },
];

const defaultFaqs = [
  {
    q: `Is the ${toolData.title} completely free?`,
    a: `Yes! SimpleInvoiceTools provides the ${toolData.title} 100% free with no registration forms or hidden fees.`,
  },
  {
    q: 'Are my business or client details saved on any server?',
    a: 'No data is stored or transmitted. All calculations, line item edits, and PDF creation happen 100% locally inside your web browser.',
  },
];

const faqsToUse = isProfitMarginTool ? profitMarginFaqs : defaultFaqs;

const schemaFAQPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqsToUse.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};

const toolPageSchemas = [schemaSoftwareApp, schemaFAQPage];
---

<BaseLayout
  title={`${toolData.title} — Free Online Tool | SimpleInvoiceTools`}
  description={toolData.description}
  schema={toolPageSchemas}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-16">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Tool Header -->
    <div class="my-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-400 bg-indigo-950/80 border border-indigo-800/60 px-3 py-1 rounded-full">
          {toolData.category}
        </span>
        {toolData.estimatedTime && (
          <span class="text-xs text-slate-400 flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Estimated time: {toolData.estimatedTime}
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        {toolData.title}
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed">
        {toolData.description}
      </p>
    </div>

    <!-- Main Workspace Area: Optimized Island Hydration with client:visible -->
    <div class="my-8 min-h-[450px]">
      {
        isDocumentGenerator ? (
          <DocumentGeneratorIsland client:visible config={docConfig} />
        ) : isProfitMarginTool ? (
          <ProfitMarginCalculatorIsland client:visible />
        ) : (
          <TaxCalculatorIsland client:visible />
        )
      }
    </div>

    <!-- Ad Slot Below Interactive Tool -->
    <AdSlot slotId={`tool-${toolData.slug}-bottom`} format="horizontal" label="ADVERTISEMENT" />

    <!-- SEO Guide & FAQs -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 my-10">
      
      <div class="lg:col-span-2 space-y-6">
        {
          isProfitMarginTool ? (
            <ProfitMarginContent />
          ) : (
            <article class="glass-card rounded-2xl p-6 sm:p-8 space-y-6">
              <h2 class="text-2xl font-bold text-white">
                How to Use the {toolData.title}
              </h2>
              <p class="text-sm text-slate-300 leading-relaxed">
                Managing client billing and tax calculations is essential for predictable business revenue. The <strong>{toolData.title}</strong> streamlines your workflow by eliminating spreadsheet templates and giving you immediate, precise figures directly in your browser.
              </p>

              <h3 class="text-lg font-semibold text-indigo-300">Key Benefits</h3>
              <ul class="list-disc list-inside space-y-2 text-sm text-slate-300">
                <li><strong>Zero Account Required:</strong> Calculate figures or create documents immediately without logging in.</li>
                <li><strong>100% Client-Side Privacy:</strong> All client names, tax numbers, and itemized calculations stay locally in your browser.</li>
                <li><strong>Instant Live Updates:</strong> Real-time calculations update dynamically as you type with zero submit buttons.</li>
              </ul>

              <h3 class="text-lg font-semibold text-indigo-300">Frequently Asked Questions</h3>
              <div class="space-y-4 text-sm text-slate-300">
                {defaultFaqs.map((faq) => (
                  <div class="border-b border-slate-800/80 pb-3">
                    <h4 class="font-bold text-white mb-1">{faq.q}</h4>
                    <p class="text-slate-400">{faq.a}</p>
                  </div>
                ))}
              </div>
            </article>
          )
        }
      </div>

      <aside class="space-y-6">
        <AdSlot slotId={`sidebar-${toolData.slug}`} format="rectangle" label="SPONSORED" />

        <div class="glass-card rounded-2xl p-6">
          <h3 class="text-base font-bold text-white mb-4 flex items-center justify-between">
            <span>Related Tools</span>
            <span class="text-xs text-indigo-400 font-normal">{toolData.category}</span>
          </h3>

          <div class="space-y-4">
            {
              relatedTools.map((rel) => (
                <a
                  href={`/tools/${rel.slug}`}
                  class="block p-3 rounded-xl bg-slate-900/60 border border-slate-800 hover:border-indigo-500/40 hover:bg-slate-900 transition-all group"
                >
                  <h4 class="text-sm font-semibold text-slate-200 group-hover:text-indigo-300 transition-colors">
                    {rel.title}
                  </h4>
                  <p class="text-xs text-slate-400 line-clamp-1 mt-1">
                    {rel.description}
                  </p>
                </a>
              ))
            }
          </div>

          <div class="mt-6 pt-4 border-t border-slate-800 text-center">
            <a href="/tools" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 inline-flex items-center gap-1">
              View All Tools Hub
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </aside>

    </div>
  </div>
</BaseLayout>
